# Mission Control — env reference (copy to .env; secrets NEVER in git)
# Postgres: postgresql+psycopg2://user:pass@host:5432/mission_control
DATABASE_URL=sqlite:///./mission_control.db
# Single operator account
OPERATOR_USERNAME=doomerius
OPERATOR_PASSWORD=change-me
# Comma list agent seeds: handle=display=role
AGENT_SEEDS=jaeger=JAEGER=Data+Trials,percival=Percival=Evidence,bedivere=BEDIVERE=Integrity,galahad=GALAHAD=Coordination
# Public base URL the app tells agents to call back to (set after DNS)
PUBLIC_BASE_URL=https://missions.blxmp.dk
