# RoundTable — environment reference (copy to .env)
# Postgres connection (set by compose; DATABASE_URL overrides for external db)
MC_DB_USER=mcuser
MC_DB_PASSWORD=change-me-db-password
MC_DB_NAME=roundtable

# Operator (human orchestrator) account
MC_OPERATOR_USERNAME=doomerius
MC_OPERATOR_PASSWORD=change-me-operator

# Session cookie signing secret — any long random string
MC_SESSION_SECRET=change-me-session-secret

# Public URL agents are told to call back to
MC_PUBLIC_BASE_URL=http://localhost:8000

# Agents seeded on first boot: handle=Display=Role (comma separated)
MC_AGENT_SEEDS=jaeger=JAEGER=Data+Trials,percival=Percival=Evidence,bedivere=BEDIVERE=Integrity,galahad=GALAHAD=Coordination

# Production: set true + your origin
MC_COOKIE_SECURE=false
MC_CORS_ORIGINS=*
